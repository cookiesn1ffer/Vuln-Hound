# Copy to .env and fill in real values. .env is gitignored — never commit it.
# These are only used by the opt-in live integration tests
# (src-tauri/tests/live_scan.rs, src-tauri/tests/live_models.rs); the app
# itself never reads .env — runtime API keys are stored in the OS keychain
# via Settings (see src-tauri/src/secrets.rs).

# Provider under test for `cargo test --test live_scan -- --ignored --nocapture`
VULN_HOUND_TEST_BASE_URL=http://localhost:11434/v1
VULN_HOUND_TEST_MODEL=huihui_ai/dolphin3-abliterated:8b

# Only needed for cloud providers (Groq, OpenCode Go/Zen, OpenRouter, Gemini).
# Leave unset for local providers (LM Studio, Ollama).
VULN_HOUND_TEST_API_KEY=
